# Copy to .env — never commit real secrets.
DATABASE_URL=postgresql+psycopg://oran:change-me@localhost:5432/oran_adapt
MLFLOW_TRACKING_URI=http://localhost:5000
LLM_PROVIDER=anthropic            # anthropic | gemini | none
