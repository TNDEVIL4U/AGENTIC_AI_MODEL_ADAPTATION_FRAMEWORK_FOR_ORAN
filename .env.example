# Copy to .env — never commit real secrets.
DATABASE_URL=postgresql+psycopg://oran:change-me@localhost:5432/oran_adapt
MLFLOW_TRACKING_URI=http://localhost:5000
# The LLM is optional and off: the pipeline decides and adapts by its rules, with no egress.
LLM_ENABLED=false
LLM_PROVIDER=none                 # anthropic | gemini | openai-compatible | none
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=   (required with LLM_PROVIDER=anthropic)
# GEMINI_API_KEY=
# GEMINI_MODEL=   (required with LLM_PROVIDER=gemini)
SANDBOX_BACKEND=subprocess        # docker | subprocess (docker also needs SANDBOX_DOCKER_IMAGE)
SANDBOX_TIMEOUT_S=120
SANDBOX_MEMORY_MB=1024
LOG_LEVEL=INFO
# docker-compose only (docs/DEPLOYMENT.md). Fill in real values in .env, never here.
POSTGRES_PASSWORD=change-me
# The compose stack's names, tags and published ports (docker-compose.yml), shown with their
# defaults. Uncomment a line to change it.
# POSTGRES_USER=oran
# POSTGRES_DB=oran_adapt
# ORAN_ADAPT_VERSION=0.1.0            # tag of the api, worker and migrator images built here
# MLFLOW_IMAGE_TAG=3.16.1             # tag of the MLflow image built from docker/mlflow
# API_PORT=8000                       # published on 127.0.0.1
# MLFLOW_PORT=5000                    # published on 127.0.0.1
# PROMETHEUS_PORT=9090                # published on 127.0.0.1
# CONNECT_PORT=8083                   # Kafka Connect REST, published on 127.0.0.1
# MLFLOW_ALLOWED_HOSTS=mlflow:5000,localhost:5000,127.0.0.1:5000
# CONNECT_GROUP_ID=oran-connect
# CONNECT_TOPIC_PREFIX=oran_connect   # Kafka Connect's _configs, _offsets and _statuses topics
# CDC_CONNECTOR_NAME=oran-kpi-sample
# CDC_TOPIC_PREFIX=oran               # Debezium topic.prefix; the topic is <prefix>.public.<table>
# CDC_SOURCE_TABLE=kpi_sample
# CDC_CONSUMER_GROUP=oran-adapt-cdc
# JSON: {"<sha256 hex of key>": "ROLE[:name]"}; make one with: oran-adapt auth new-key --role OPERATOR --name me
API_KEYS={}

# ---- Optional overrides: every other setting, shown with its default (src/oran_adapt/core/config.py).
# ---- Uncomment a line to change it for this environment.

# Storage and registry
# MLFLOW_REGISTRY_URI=
# ARTIFACT_WORKDIR=./data/artifacts
# LIVE_ALIAS=live
# CANDIDATE_ALIAS=candidate
# MLFLOW_SKOPS_TRUSTED_TYPES=["sklearn.tree._tree.Tree", "sklearn.ensemble._hist_gradient_boosting.predictor.TreePredictor"]
# ARTIFACT_MAX_BYTES=2147483648

# MLFLOW_TELEMETRY=false           # MLflow's usage reports to its vendor; off by default
# MLFLOW_PIP_REQUIREMENTS=["scikit-learn"]   # pin, and skip MLflow's requirements inference

# LLM (docs/adapters/llm.md)
# LLM_TIMEOUT_S=60.0
# LLM_MAX_OUTPUT_TOKENS=2048
# LLM_MAX_RETRIES=0
# LLM_RETRY_BACKOFF_S=0.5
# LLM_BREAKER_FAILURE_THRESHOLD=3
# LLM_BREAKER_RESET_S=60.0
# LLM_MAX_INPUT_TOKENS=16000
# LLM_TOKEN_BUDGET=0               # per LLM_BUDGET_WINDOW_S, across processes; 0 = no cap
# LLM_COST_BUDGET=0.0
# LLM_BUDGET_WINDOW_S=86400
# LLM_COST_PER_1K_INPUT_TOKENS=0.0
# LLM_COST_PER_1K_OUTPUT_TOKENS=0.0
# LLM_CHARS_PER_TOKEN=4.0
# LLM_PROMPT_VERSIONS={"strategy-selection": "1", "adaptation-code": "1"}
# LLM_PROMPT_DIR=
# ANTHROPIC_BASE_URL=
# GEMINI_BASE_URL=
# LLM_OPENAI_BASE_URL=http://vllm.internal:8000/v1
# LLM_OPENAI_MODEL=
# LLM_OPENAI_API_KEY=

# Sandbox
# SANDBOX_DOCKER_IMAGE=   (required with SANDBOX_BACKEND=docker, as name@sha256:...)

# Jobs and locking
# JOB_MAX_RETRIES=2
# JOB_RETRY_BACKOFF_S=1.0
# JOB_TIMEOUT_S=600.0
# JOB_EXECUTION_MODE=process
# MODEL_LOCK_TTL_S=3600.0

# Probes and migrations (docs/operations/helm.md, docs/operations/migrations.md)
# WORKER_HEALTH_FILE=/tmp/oran-adapt/worker.alive
# WORKER_HEALTH_MAX_AGE_S=120.0

# Observability (docs/operations/observability.md)
# WORKER_METRICS_PORT=
# WORKER_METRICS_ADDR=
# TRACING_EXPORTER=none
# TRACING_SERVICE_NAME=oran-adapt
# TRACING_SAMPLE_RATIO=1.0
# TRACING_JSONL_PATH=
# TRACING_OTLP_ENDPOINT=
# TRACING_OTLP_TIMEOUT_S=10.0
# MIGRATION_WAIT_TIMEOUT_S=600.0
# MIGRATION_WAIT_INTERVAL_S=2.0

# Analysis and reuse thresholds
# ANALYSIS_PSI_REUSE_THRESHOLD=0.1
# ANALYSIS_KS_PVALUE_REUSE_THRESHOLD=0.05
# ANALYSIS_DRIFT_SCORE_REUSE_THRESHOLD=0.3
# ANALYSIS_MIN_PSI_ROWS=30
# REUSE_ENABLED=true
# REUSE_MAX_VERSIONS=10
# REUSE_MIN_ACCURACY_GAIN=0.02
# REUSE_MIN_RMSE_REDUCTION_RATIO=0.05
# REUSE_MAX_MODEL_AGE_DAYS=
# REUSE_CONFIDENCE_ROWS=100

# Decision
# DECISION_MIN_DRIFTED_ROWS=10
# DECISION_FULL_RETRAIN_PSI_THRESHOLD=0.5
# Empty: every framework an installed model type plugin can adapt.
# DECISION_SUPPORTED_FRAMEWORKS=[]

# Validation and leakage checks
# VALIDATION_MIN_ROWS=5
# VALIDATION_HOLDOUT_FRACTION=0.2
# Validation gate (Hardening Phase 7): a versioned policy, inline JSON or a TOML/JSON file.
# Default: superiority (the candidate must be better, 95 % paired-bootstrap interval above 0).
# GATE_POLICY_FILE=config/policies/gate.toml
# GATE_POLICY={"mode": "non_inferiority", "margin": 0.02}

# Progressive delivery (docs/adapters/rollout_metrics.md)
# DELIVERY_STRATEGY=shadow            # shadow | canary | blue_green | ab | manual
# DELIVERY_POLICY_FILE=config/policies/delivery.toml
# DRIFT_MAPPERS={"alertmanager":"config/mappers/alertmanager.toml"}   # docs/integration-guide.md
# DRIFT_MAPPER_MAX_EVENTS=100
# ROLLOUT_METRICS_BACKEND=api         # api | prometheus
# ROLLOUT_TICK_S=30
# ROLLOUT_PROMETHEUS_URL=
# ROLLOUT_PROMETHEUS_TOKEN=
# ROLLOUT_PROMETHEUS_QUERIES={}
# ROLLOUT_PROMETHEUS_REQUESTS_QUERY=
# DEPLOYMENT_CANARY_ALIAS=canary
# DEPLOYMENT_TRAFFIC_TAG=oran.traffic_percent
# LEAKAGE_CHECKS_ENABLED=true
# LEAKAGE_ALLOW_FUTURE_ROWS=false
# LEAKAGE_TARGET_CORRELATION_MAX=

# Training (torch engines)
# TORCH_FINE_TUNE_EPOCHS=5
# TORCH_FULL_RETRAIN_EPOCHS=300
# TORCH_LEARNING_RATE=0.01

# Model types (docs/adapters/model_type.md)
# MODEL_TYPES=[]
# SEQUENCE_WINDOW=8
# SEQUENCE_VALIDATION_FRACTION=0.2
# SEQUENCE_FINE_TUNE_EPOCHS=20
# SEQUENCE_FULL_RETRAIN_EPOCHS=200
# SEQUENCE_LEARNING_RATE=0.01
# ONNX_RUNTIME=onnxruntime

# API and observability
# LOG_JSON=true
# API_MAX_REQUEST_BYTES=10485760
# AUTH_ENABLED=true
# METRICS_PUBLIC=true
# API_DOCS_ENABLED=            # unset: on outside production, off in production
# API_HSTS_MAX_AGE_S=0         # set (e.g. 31536000) only when every client uses HTTPS
# API_RATE_LIMIT_PER_MINUTE=600
# API_RATE_LIMIT_BURST=100
# API_AUTH_FAILURE_LIMIT_PER_MINUTE=30
# API_RATE_LIMIT_MAX_KEYS=10000

# Authentication backends (docs/adapters/auth.md, docs/security.md)
# AUTH_BACKEND=api-key         # api-key | oidc | gateway | mtls
# AUTH_OIDC_ISSUER=https://idp.example.com/realms/oran
# AUTH_OIDC_AUDIENCE=oran-adapt
# AUTH_OIDC_JWKS_URL=          # unset: from the issuer's discovery document
# AUTH_ROLE_CLAIM=roles        # dotted path, e.g. realm_access.roles
# AUTH_ROLE_MAP={"oran-admin":"ADMIN","oran-operator":"OPERATOR","oran-ml":"ML_ENGINEER","oran-viewer":"READ_ONLY"}
# AUTH_NAME_CLAIM=sub
# AUTH_JWT_ALGORITHMS=["RS256","ES256"]
# AUTH_JWT_LEEWAY_S=60
# AUTH_JWKS_CACHE_TTL_S=300
# AUTH_JWKS_MIN_REFETCH_S=30
# AUTH_HTTP_TIMEOUT_S=5
# AUTH_GATEWAY_ISSUERS={"https://gateway.example.com":"https://gateway.example.com/jwks"}
# AUTH_GATEWAY_HEADER=X-Jwt-Assertion
# AUTH_GATEWAY_AUDIENCE=
# AUTH_MTLS_CA_FILE=/etc/oran-adapt/client-ca.pem
# AUTH_MTLS_CERT_HEADER=X-Forwarded-Client-Cert
# AUTH_MTLS_IDENTITIES={"noc-client":"OPERATOR"}
# AUTH_TRUSTED_PROXIES=["10.0.0.0/24"]   # gateway and mtls read proxy headers only from these
# POLICY_BACKEND=static-rbac    # static-rbac | opa
# POLICY_OPA_URL=http://127.0.0.1:8181
# POLICY_OPA_PATH=oran_adapt/authz/allow
# POLICY_OPA_TOKEN=
# POLICY_OPA_TIMEOUT_S=2
# POLICY_OPA_CACHE_S=30

# Secrets backends
# SECRETS_BACKEND=env          # env | file | vault
# SECRETS_DIR=/run/secrets
# SECRETS_VAULT_URL=https://vault.example.com:8200
# SECRETS_VAULT_TOKEN_FILE=/vault/secrets/token
# SECRETS_VAULT_MOUNT=secret
# SECRETS_VAULT_PATH=oran-adapt
# SECRETS_VAULT_NAMESPACE=
# SECRETS_VAULT_TIMEOUT_S=10

# Outbound HTTP policy (SSRF and TLS; docs/security.md section 5)
# OUTBOUND_ALLOWLIST=["mlflow.internal",".svc.cluster.local","10.20.0.0/16"]
# OUTBOUND_BLOCKED_HOSTS=["localhost","metadata","metadata.google.internal","instance-data"]
# OUTBOUND_RESOLVE_HOSTS=true
# OUTBOUND_REQUIRE_HTTPS=      # unset: on in production
# OUTBOUND_TLS_MIN_VERSION=TLSv1.2
# OUTBOUND_CA_FILE=

# CDC and Kafka
# CDC_MODE=disabled
# CDC_BATCH_SIZE=500
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# CDC_KAFKA_TOPIC=   (required with CDC_MODE=kafka, e.g. oran.public.kpi_sample)
# CDC_CONSUMER_GROUP=   (required with CDC_MODE=kafka; unique per installation, e.g. oran-adapt-cdc)
# CDC_KAFKA_POLL_TIMEOUT_S=1.0
