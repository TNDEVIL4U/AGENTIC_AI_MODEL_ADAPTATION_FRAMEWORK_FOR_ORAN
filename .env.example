# Copy to .env — never commit real secrets.
DATABASE_URL=postgresql+psycopg://oran:change-me@localhost:5432/oran_adapt
MLFLOW_TRACKING_URI=http://localhost:5000
LLM_PROVIDER=anthropic            # anthropic | gemini | none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
SANDBOX_BACKEND=docker            # docker | subprocess
SANDBOX_TIMEOUT_S=120
SANDBOX_MEMORY_MB=1024
LOG_LEVEL=INFO
# docker-compose only (docs/DEPLOYMENT.md). Fill in real values in .env, never here.
POSTGRES_PASSWORD=change-me
# JSON: {"<sha256 hex of key>": "ROLE[:name]"}; make one with: oran-adapt auth new-key --role OPERATOR --name me
API_KEYS={}

# ---- Optional overrides: every other setting, shown with its default (src/oran_adapt/core/config.py).
# ---- Uncomment a line to change it for this environment.

# Storage and registry
# MLFLOW_REGISTRY_URI=
# ARTIFACT_WORKDIR=./data/artifacts
# LIVE_ALIAS=live
# CANDIDATE_ALIAS=candidate
# MLFLOW_SKOPS_TRUSTED_TYPES=["sklearn.tree._tree.Tree", "sklearn.ensemble._hist_gradient_boosting.predictor.TreePredictor"]
# ARTIFACT_MAX_BYTES=2147483648

# LLM
# LLM_TIMEOUT_S=60.0

# Sandbox
# SANDBOX_DOCKER_IMAGE=oran-adapt-sandbox:latest

# Jobs and locking
# JOB_MAX_RETRIES=2
# JOB_RETRY_BACKOFF_S=1.0
# JOB_TIMEOUT_S=600.0
# JOB_EXECUTION_MODE=process
# MODEL_LOCK_TTL_S=3600.0

# Analysis and reuse thresholds
# ANALYSIS_PSI_REUSE_THRESHOLD=0.1
# ANALYSIS_KS_PVALUE_REUSE_THRESHOLD=0.05
# ANALYSIS_DRIFT_SCORE_REUSE_THRESHOLD=0.3
# ANALYSIS_MIN_PSI_ROWS=30
# REUSE_ENABLED=true
# REUSE_MAX_VERSIONS=10
# REUSE_MIN_ACCURACY_GAIN=0.02
# REUSE_MIN_RMSE_REDUCTION_RATIO=0.05
# REUSE_MAX_MODEL_AGE_DAYS=
# REUSE_CONFIDENCE_ROWS=100

# Decision
# DECISION_MIN_DRIFTED_ROWS=10
# DECISION_FULL_RETRAIN_PSI_THRESHOLD=0.5
# Empty: every framework an installed model type plugin can adapt.
# DECISION_SUPPORTED_FRAMEWORKS=[]

# Validation and leakage checks
# VALIDATION_MIN_ROWS=5
# VALIDATION_HOLDOUT_FRACTION=0.2
# Validation gate (Hardening Phase 7): a versioned policy, inline JSON or a TOML/JSON file.
# Default: superiority (the candidate must be better, 95 % paired-bootstrap interval above 0).
# GATE_POLICY_FILE=config/policies/gate.toml
# GATE_POLICY={"mode": "non_inferiority", "margin": 0.02}

# Progressive delivery (docs/adapters/rollout_metrics.md)
# DELIVERY_STRATEGY=shadow            # shadow | canary | blue_green | ab | manual
# DELIVERY_POLICY_FILE=config/policies/delivery.toml
# ROLLOUT_METRICS_BACKEND=api         # api | prometheus
# ROLLOUT_TICK_S=30
# ROLLOUT_PROMETHEUS_URL=
# ROLLOUT_PROMETHEUS_TOKEN=
# ROLLOUT_PROMETHEUS_QUERIES={}
# ROLLOUT_PROMETHEUS_REQUESTS_QUERY=
# DEPLOYMENT_CANARY_ALIAS=canary
# DEPLOYMENT_TRAFFIC_TAG=oran.traffic_percent
# LEAKAGE_CHECKS_ENABLED=true
# LEAKAGE_ALLOW_FUTURE_ROWS=false
# LEAKAGE_TARGET_CORRELATION_MAX=

# Training (torch engines)
# TORCH_FINE_TUNE_EPOCHS=5
# TORCH_FULL_RETRAIN_EPOCHS=300
# TORCH_LEARNING_RATE=0.01

# Model types (docs/adapters/model_type.md)
# MODEL_TYPES=[]
# SEQUENCE_WINDOW=8
# SEQUENCE_VALIDATION_FRACTION=0.2
# SEQUENCE_FINE_TUNE_EPOCHS=20
# SEQUENCE_FULL_RETRAIN_EPOCHS=200
# SEQUENCE_LEARNING_RATE=0.01
# ONNX_RUNTIME=onnxruntime

# API and observability
# LOG_JSON=true
# API_MAX_REQUEST_BYTES=10485760
# AUTH_ENABLED=true
# METRICS_PUBLIC=true

# CDC and Kafka
# CDC_MODE=disabled
# CDC_BATCH_SIZE=500
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# CDC_KAFKA_TOPIC=oran.public.kpi_sample
# CDC_CONSUMER_GROUP=oran-adapt-cdc
# CDC_KAFKA_POLL_TIMEOUT_S=1.0
